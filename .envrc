#!/usr/bin/env bash

# Automatically sets up your devbox environment whenever you cd into this
# directory via our direnv integration:

eval "$(devbox generate direnv --print-envrc)"

# check out https://www.jetify.com/docs/devbox/ide_configuration/direnv/
# for more details

# Use a 1Password service account token so op CLI calls don't prompt.
# Token lives outside the repo at ~/.op/token (mode 600).
if [ -f "$HOME/.op/token" ]; then
  export OP_SERVICE_ACCOUNT_TOKEN=$(cat "$HOME/.op/token")
fi

export ANTHROPIC_API_KEY=$(op read "op://Development Secrets/ANTHROPIC_API_KEY/password")
